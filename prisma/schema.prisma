// Mahall — Phase 1 schema.
// Every masjid-owned record carries masjidId for tenant isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RESIDENT
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum BoardStatus {
  ACTIVE
  PREVIOUS
}

model Masjid {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  // Counters for human-readable IDs (FAM-0001, MEM-0001)
  familySeq      Int @default(0)
  memberSeq      Int @default(0)
  receiptSeq     Int @default(0)
  meetingSeq     Int @default(0)
  applicationSeq Int @default(0)
  certificateSeq Int @default(0)
  incomeSeq      Int @default(0)
  expenseSeq     Int @default(0)

  // Finance: balance = opening balance + income − expenses (from openingBalanceDate on).
  openingBalance          Int       @default(0)
  openingBalanceDate      DateTime?
  /// Residents see finance figures only up to this date (the admin publishes month by month).
  financePublishedThrough DateTime?

  users         User[]
  families      Family[]
  members       Member[]
  boardMembers  BoardMember[]
  auditLogs     AuditLog[]
  plans         SubscriptionPlan[]
  invoices      SubscriptionInvoice[]
  payments      Payment[]
  notifications Notification[]
  meetings      Meeting[]
  forms         Form[]
  applications  Application[]
  files         StoredFile[]
  incomes       Income[]
  expenses      Expense[]
}

model User {
  id           String    @id @default(cuid())
  masjidId     String?
  masjid       Masjid?   @relation(fields: [masjidId], references: [id])
  email        String?   @unique
  phone        String?   @unique
  name         String
  passwordHash String?
  role         Role      @default(RESIDENT)
  isActive     Boolean   @default(true)
  // Invitation-based activation: admin creates user, resident sets password.
  inviteToken  String?   @unique
  inviteExpiry DateTime?
  resetToken   String?   @unique
  resetExpiry  DateTime?
  memberId     String?   @unique
  member       Member?   @relation(fields: [memberId], references: [id])
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  sessions              Session[]
  auditLogs             AuditLog[]
  paymentsSubmitted     Payment[]                  @relation("PaymentSubmitter")
  paymentsVerified      Payment[]                  @relation("PaymentVerifier")
  Notification          Notification[]
  NotificationRecipient NotificationRecipient[]
  Meeting               Meeting[]
  applications          Application[]
  filesUploaded         StoredFile[]
  statusChanges         ApplicationStatusHistory[]
  incomesRecorded       Income[]
  expensesRecorded      Expense[]

  @@index([masjidId])
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Family {
  id               String   @id @default(cuid())
  masjidId         String
  masjid           Masjid   @relation(fields: [masjidId], references: [id])
  familyCode       String // FAM-0001, unique within masjid
  familyName       String
  houseName        String?
  houseNumber      String?
  address          String?
  ward             String?
  headMemberId     String?  @unique
  headMember       Member?  @relation("FamilyHead", fields: [headMemberId], references: [id])
  primaryPhone     String?
  secondaryPhone   String?
  registrationDate DateTime @default(now())
  status           Status   @default(ACTIVE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members Member[] @relation("FamilyMembers")

  // Exempt families are skipped when monthly invoices are generated.
  subscriptionExempt Boolean               @default(false)
  exemptReason       String?
  invoices           SubscriptionInvoice[]
  payments           Payment[]

  @@unique([masjidId, familyCode])
  @@unique([masjidId, houseNumber, ward])
  @@index([masjidId, familyName])
}

model Member {
  id               String    @id @default(cuid())
  masjidId         String
  masjid           Masjid    @relation(fields: [masjidId], references: [id])
  memberCode       String // MEM-0001
  familyId         String
  family           Family    @relation("FamilyMembers", fields: [familyId], references: [id])
  fullName         String
  gender           Gender
  dateOfBirth      DateTime?
  phone            String?
  email            String?
  relationship     String // Head, Wife, Son, Daughter, ...
  address          String?
  status           Status    @default(ACTIVE)
  registrationDate DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  headOf Family? @relation("FamilyHead")
  user   User?

  @@unique([masjidId, memberCode])
  @@index([masjidId, fullName])
  @@index([familyId])
}

model BoardMember {
  id          String      @id @default(cuid())
  masjidId    String
  masjid      Masjid      @relation(fields: [masjidId], references: [id])
  fullName    String
  photoUrl    String?
  designation String
  phone       String?
  email       String?
  showContact Boolean     @default(true) // approved for display to residents
  termStart   DateTime
  termEnd     DateTime?
  status      BoardStatus @default(ACTIVE)
  sortOrder   Int         @default(100)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([masjidId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  masjidId   String
  masjid     Masjid   @relation(fields: [masjidId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. family.create
  entityType String
  entityId   String?
  summary    String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([masjidId, createdAt])
}

// ───────────── Phase 2: subscriptions & manual payments ─────────────
// Amounts are whole rupees (Int).

model SubscriptionPlan {
  id            String   @id @default(cuid())
  masjidId      String
  masjid        Masjid   @relation(fields: [masjidId], references: [id])
  name          String // e.g. "FY 2026-27"
  startMonth    DateTime // first day of the first billing month
  months        Int      @default(12)
  annualAmount  Int
  monthlyAmount Int
  dueDay        Int      @default(10) // day of month the installment is due
  graceDays     Int      @default(5)
  lateFee       Int      @default(0) // flat fee per overdue installment
  upiId         String? // masjid UPI ID shown to residents
  upiName       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices SubscriptionInvoice[]

  @@index([masjidId, isActive])
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
}

model SubscriptionInvoice {
  id          String           @id @default(cuid())
  masjidId    String
  masjid      Masjid           @relation(fields: [masjidId], references: [id])
  planId      String
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  familyId    String
  family      Family           @relation(fields: [familyId], references: [id])
  periodMonth DateTime // first day of the month this installment covers
  dueDate     DateTime
  amount      Int
  lateFee     Int              @default(0) // applied once the installment passes due date + grace
  paidAmount  Int              @default(0)
  status      InvoiceStatus    @default(PENDING)
  note        String? // waiver reason / adjustment note
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  allocations PaymentAllocation[]
  reminders   ReminderLog[]

  @@unique([planId, familyId, periodMonth])
  @@index([masjidId, status, dueDate])
  @@index([familyId])
}

enum PaymentMethod {
  UPI_MANUAL
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model Payment {
  id            String        @id @default(cuid())
  masjidId      String
  masjid        Masjid        @relation(fields: [masjidId], references: [id])
  familyId      String
  family        Family        @relation(fields: [familyId], references: [id])
  amount        Int
  method        PaymentMethod
  reference     String? // UPI UTR / bank reference
  paidOn        DateTime
  status        PaymentStatus @default(PENDING_VERIFICATION)
  receiptNo     String? // RCP-0001, assigned on verification
  notes         String?
  rejectReason  String?
  submittedById String?
  submittedBy   User?         @relation("PaymentSubmitter", fields: [submittedById], references: [id])
  verifiedById  String?
  verifiedBy    User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())

  allocations PaymentAllocation[]
  income      Income?

  @@unique([masjidId, reference])
  @@unique([masjidId, receiptNo])
  @@index([masjidId, status, createdAt])
  @@index([familyId])
}

/// Which installments a payment covers. Applied to invoice.paidAmount only once the payment is verified.
model PaymentAllocation {
  id        String              @id @default(cuid())
  paymentId String
  payment   Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   SubscriptionInvoice @relation(fields: [invoiceId], references: [id])
  amount    Int

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// ───────────── Phase 3: notifications, announcements & meetings ─────────────

enum NotificationCategory {
  SUBSCRIPTION
  PAYMENT
  MEETING
  EMERGENCY
  ACTIVITY
  APPLICATION
  NOTICE
  EVENT
}

enum Priority {
  NORMAL
  IMPORTANT
  URGENT
}

enum Audience {
  ALL
  FAMILIES
  MEMBERS
  PENDING_SUBSCRIPTION
  BOARD
  WARDS
  DIRECT // system message to specific accounts (payment confirmations etc.)
}

model Notification {
  id            String               @id @default(cuid())
  masjidId      String
  masjid        Masjid               @relation(fields: [masjidId], references: [id])
  title         String
  body          String
  category      NotificationCategory
  priority      Priority             @default(NORMAL)
  audience      Audience
  audienceLabel String? // human summary, e.g. "Ward 1, Ward 2"
  attachmentUrl String?
  publishAt     DateTime             @default(now())
  expiresAt     DateTime?
  automated     Boolean              @default(false)
  createdById   String?
  createdBy     User?                @relation(fields: [createdById], references: [id])
  meetingId     String?
  meeting       Meeting?             @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())

  recipients NotificationRecipient[]

  @@index([masjidId, publishAt])
}

/// Audience is resolved to accounts when the notification is created, so history shows exactly who received it.
model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

enum ReminderKind {
  UPCOMING
  DUE_TODAY
  OVERDUE
}

/// Makes automated subscription reminders idempotent: one per installment per kind.
model ReminderLog {
  id        String              @id @default(cuid())
  invoiceId String
  invoice   SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind      ReminderKind
  sentAt    DateTime            @default(now())

  @@unique([invoiceId, kind])
}

enum MeetingStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

model Meeting {
  id                 String        @id @default(cuid())
  masjidId           String
  masjid             Masjid        @relation(fields: [masjidId], references: [id])
  meetingCode        String // MTG-0001
  title              String
  description        String?
  category           String // General Body, Committee, Special, ...
  startsAt           DateTime
  location           String
  attendance         String        @default("Open to all residents")
  attachmentUrl      String?
  status             MeetingStatus @default(DRAFT)
  minutes            String?
  minutesPublishedAt DateTime?
  createdById        String?
  createdBy          User?         @relation(fields: [createdById], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  agenda        AgendaItem[]
  notifications Notification[]

  @@unique([masjidId, meetingCode])
  @@index([masjidId, startsAt])
}

model AgendaItem {
  id         String  @id @default(cuid())
  meetingId  String
  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  position   Int
  title      String
  details    String?
  resolution String? // decision recorded after the meeting; public once minutes are published

  @@index([meetingId, position])
}

// ───────────── Phase 4: certificate applications & form builder ─────────────

enum FormCategory {
  MARRIAGE_CERTIFICATE
  MARRIAGE_REGISTRATION
  MEMBERSHIP_CERTIFICATE
  RESIDENCE_CERTIFICATE
  OTHER
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  RADIO
  CHECKBOX
  FILE
  DECLARATION
}

model Form {
  id                  String       @id @default(cuid())
  masjidId            String
  masjid              Masjid       @relation(fields: [masjidId], references: [id])
  name                String
  category            FormCategory
  description         String?
  isActive            Boolean      @default(false)
  /// Generated certificate text. {{Field label}} placeholders are filled from answers;
  /// also {{applicant}}, {{family}}, {{certificate_no}}, {{date}}, {{masjid}}.
  certificateTemplate String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  fields       FormField[]
  applications Application[]

  @@index([masjidId, isActive])
}

model FormField {
  id       String    @id @default(cuid())
  formId   String
  form     Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  position Int
  label    String
  type     FieldType
  required Boolean   @default(false)
  options  String[]
  helpText String?

  @@index([formId, position])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUIRED
  APPROVED
  REJECTED
  CERTIFICATE_READY
  COMPLETED
}

model Application {
  id              String            @id @default(cuid())
  masjidId        String
  masjid          Masjid            @relation(fields: [masjidId], references: [id])
  appCode         String? // APP-2026-0001, assigned on first submission
  formId          String
  form            Form              @relation(fields: [formId], references: [id])
  applicantId     String
  applicant       User              @relation(fields: [applicantId], references: [id])
  familyId        String?
  /// Field definitions at (last) submission, so later form edits don't change history.
  fieldsSnapshot  Json?
  /// { [fieldId]: string | string[] | boolean }
  answers         Json              @default("{}")
  status          ApplicationStatus @default(DRAFT)
  submittedAt     DateTime?
  certificateNo   String?
  certificateText String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  files   StoredFile[]
  history ApplicationStatusHistory[]

  @@unique([masjidId, appCode])
  @@unique([masjidId, certificateNo])
  @@index([masjidId, status])
  @@index([applicantId])
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  from          ApplicationStatus?
  to            ApplicationStatus
  note          String? // shown to the applicant
  byUserId      String?
  byUser        User?              @relation(fields: [byUserId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([applicationId, createdAt])
}

enum FileKind {
  SUPPORTING
  CERTIFICATE
  RECEIPT // finance receipts / supporting documents (admin-only)
}

/// Private uploaded file. Bytes live outside the web root (local disk in dev; S3-compatible later).
model StoredFile {
  id            String       @id @default(cuid())
  masjidId      String
  masjid        Masjid       @relation(fields: [masjidId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldId       String?
  kind          FileKind     @default(SUPPORTING)
  originalName  String
  mimeType      String
  size          Int
  sha256        String
  storageKey    String       @unique
  uploadedById  String?
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime     @default(now())

  incomeOf  Income[]
  expenseOf Expense[]

  @@index([applicationId])
}

// ───────────── Phase 5: income & expense management ─────────────

enum IncomeCategory {
  SUBSCRIPTION
  DONATION
  ZAKAT
  EVENT_COLLECTION
  OTHER
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  MAINTENANCE
  STAFF_SALARY
  RELIGIOUS_ACTIVITIES
  COMMUNITY_EVENTS
  CONSTRUCTION
  OTHER
}

enum FinanceMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

/// Income record. Subscription payments create one automatically when verified (paymentId set).
/// Records are never deleted: corrections void the record with a reason (audit trail).
model Income {
  id           String         @id @default(cuid())
  masjidId     String
  masjid       Masjid         @relation(fields: [masjidId], references: [id])
  txnCode      String // INC-00001
  category     IncomeCategory
  description  String
  amount       Int
  date         DateTime
  method       FinanceMethod
  reference    String?
  /// Private: never shown to residents.
  donorName    String?
  paymentId    String?        @unique
  payment      Payment?       @relation(fields: [paymentId], references: [id])
  attachmentId String?
  attachment   StoredFile?    @relation(fields: [attachmentId], references: [id])
  recordedById String?
  recordedBy   User?          @relation(fields: [recordedById], references: [id])
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime       @default(now())

  @@unique([masjidId, txnCode])
  @@index([masjidId, date])
}

model Expense {
  id           String          @id @default(cuid())
  masjidId     String
  masjid       Masjid          @relation(fields: [masjidId], references: [id])
  txnCode      String // EXP-00001
  category     ExpenseCategory
  description  String
  amount       Int
  date         DateTime
  method       FinanceMethod
  reference    String?
  recipient    String? // vendor / payee
  approvedBy   String?
  receiptId    String?
  receipt      StoredFile?     @relation(fields: [receiptId], references: [id])
  recordedById String?
  recordedBy   User?           @relation(fields: [recordedById], references: [id])
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime        @default(now())

  @@unique([masjidId, txnCode])
  @@index([masjidId, date])
}
